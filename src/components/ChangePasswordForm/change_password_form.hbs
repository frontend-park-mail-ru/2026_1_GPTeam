<form class="change-password-form" id="change-password-form">
    <div class="change-password__field">
        <label class="change-password__label" for="change-password-current">Текущий пароль</label>
        <div class="change-password__input-wrapper">
            <input class="change-password__input" id="change-password-current" type="password" autocomplete="current-password" placeholder="Введите текущий пароль">
            <img class="change-password__eye" id="eye-current" src="/icons/closed_eye.svg" alt="Показать пароль">
        </div>
    </div>
    <div class="change-password__field">
        <label class="change-password__label" for="change-password-new">Новый пароль</label>
        <div class="change-password__input-wrapper">
            <input class="change-password__input" id="change-password-new" type="password" autocomplete="new-password" placeholder="Введите новый пароль">
            <img class="change-password__eye" id="eye-new" src="/icons/closed_eye.svg" alt="Показать пароль">
            <div class="change-password__help-wrap">
                <img class="change-password__help" src="/icons/question.svg" alt="Справка">
                <div class="change-password__tooltip">Минимум 8 символов, заглавная буква и цифра</div>
            </div>
        </div>
    </div>
    <div class="change-password__field">
        <label class="change-password__label" for="change-password-confirm">Повторите пароль</label>
        <div class="change-password__input-wrapper">
            <input class="change-password__input" id="change-password-confirm" type="password" autocomplete="new-password" placeholder="Введите подтверждение пароля">
            <img class="change-password__eye" id="eye-confirm" src="/icons/closed_eye.svg" alt="Показать пароль">
        </div>
    </div>

    <p class="change-password__error" id="change-password-error"></p>

    <div class="change-password__actions">
        <button type="submit" class="change-password__btn-save">Изменить пароль</button>
        <button type="button" class="change-password__btn-cancel" id="change-password-cancel-btn">Отмена</button>
    </div>
</form>